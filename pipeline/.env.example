# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN DE ENTORNO LOCAL (.env)
# ==============================================================================
# IMPORTANTE: Copia este archivo, renómbralo a ".env" (sin el .example)
# y reemplaza las rutas con las ubicaciones reales donde descargaste
# los datos del Censo y el SECOP en tu propia computadora.
#
# Al estar en .env, Git ignorará este archivo y nadie pisará las rutas de nadie.
#
# NOTA: Si NO configuras estas rutas, el pipeline buscará automáticamente
# los archivos en la carpeta ../Datos/ (al mismo nivel que el repositorio).
# ==============================================================================

# 1. RUTA AL DATASET DEL CENSO 2018 (Directorio que contiene las 33 carpetas departamentales CSV)
# Ejemplo Windows: C:\Usuarios\TuNombre\Descargas\CENSO 2018 dep
# Ejemplo Mac/Linux: /Users/tunombre/Downloads/CENSO 2018 dep
CNPV_CSV_DIR="PON_TU_RUTA_AL_CENSO_AQUI"

# 2. RUTA AL ARCHIVO CSV DE SECOP I (Procesos de Compra Pública)
# Ejemplo: C:\Proyectos\Datos\SECOP_I_-_Procesos_de_Compra_Publica_20260412.csv
SECOP_I_CSV_PATH="PON_TU_RUTA_AL_CSV_SECOP_I_AQUI"

# 3. RUTA AL ARCHIVO CSV DE SECOP II (Contratos Electrónicos)
# Ejemplo: C:\Proyectos\Datos\SECOP_II_-_Contratos_Electronicos_20260412.csv
SECOP_CSV_PATH="PON_TU_RUTA_AL_CSV_SECOP_II_AQUI"

# 4. RUTA AL DATASET DE EMICRON (Directorio con los CSVs de EMICRON 2024)
# Ejemplo: C:\Proyectos\Datos (directorio que contiene las carpetas "EMICRON 2019", "EMICRON 2020", etc.)
# Si dejas la carpeta Datos/ al mismo nivel que el repo, NO necesitas configurar esto.
EMICRON_CSV_PATH="PON_TU_RUTA_BASE_DE_DATOS_AQUI"

# 5. RUTA AL ARCHIVO CSV DE PROYECCIONES CENSALES
# Ejemplo: C:\Proyectos\Datos\PPED-AreaDep-2018-2050_VP.csv
PROYECCIONES_CENSO_PATH="PON_TU_RUTA_A_PROYECCIONES_AQUI"

# 6. TOKENS DE API (Opcional, si usas la extracción en vivo de Socrata)
# SODA_APP_TOKEN="tu_token_aqui"
# SODA_APP_SECRET="tu_secret_aqui"

# Nivel de Logs (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL="INFO"
